# ============================================
# CMS_CRM_SOLUTIONS - Configuration (exemple)
# ============================================
# Copier en .env à la racine : cp .env.example .env
# Docker Compose charge ce .env ; ne pas committer .env (secrets).

# Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=changez-moi-en-production-50-caracteres-minimum
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (doit correspondre au healthcheck dans docker-compose)
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME=cmscrm
DB_USER=cmscrm_user
DB_PASSWORD=cmscrm_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Django
DJANGO_SETTINGS_MODULE=config.core.settings
LANGUAGE_CODE=fr-fr
TIME_ZONE=Europe/Paris

# API / URLs (frontend lit NEXT_PUBLIC_API_URL)
API_URL=http://localhost:9193/api
NEXT_PUBLIC_API_URL=http://localhost:9193/api
FRONTEND_URL=http://localhost:9194

# Email (SMTP) — à remplir pour envoi réel
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@cms-crm-solutions.com

# File Storage (optionnel)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1

# Multi-tenant
PUBLIC_SCHEMA_NAME=public
TENANT_MODEL=tenants.Client

# Billing (Stripe) — optionnel en phase de test
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:9194,http://127.0.0.1:9194
CSRF_TRUSTED_ORIGINS=http://localhost:9194,http://127.0.0.1:9194

# Logging
LOG_LEVEL=INFO

# Docker
COMPOSE_PROJECT_NAME=cms_crm_solutions
