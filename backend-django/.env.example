# ============================================
# CMS CRM Solutions - Configuration Backend Django
# ============================================
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement

# ============================================
# BASE DE DONNÉES
# ============================================
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME=cmscrm
DB_USER=cmscrm_user
DB_PASSWORD=cmscrm_password
DB_HOST=db
DB_PORT=5432

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# SÉCURITÉ
# ============================================
SECRET_KEY=django-insecure-change-this-in-production-key
DEBUG=1
ALLOWED_HOSTS=*

# ============================================
# URLS FRONTEND (IMPORTANT POUR LES EMAILS)
# ============================================
# URL publique du frontend (utilisée dans les emails de reset password, invitations, etc.)
# DÉVELOPPEMENT:
FRONTEND_URL=http://localhost:9194
# PRODUCTION (exemple):
# FRONTEND_URL=https://cms-crm-solutions.com

# ============================================
# CONFIGURATION EMAIL SMTP
# ============================================
EMAIL_HOST=ssl0.ovh.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=test@example.com
EMAIL_HOST_PASSWORD=your-email-password-here
DEFAULT_FROM_EMAIL=noreply@cms-crm-solutions.com
