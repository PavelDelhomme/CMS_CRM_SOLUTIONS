# ============================================
# CMS CRM Solutions - Backend Django (exemple)
# ============================================
# Avec Docker : le .env à la racine du projet est utilisé (env_file dans docker-compose).
# Ce fichier sert pour lancer le backend en local (sans Docker) ou en référence.

# Base de données (aligné avec docker-compose et healthcheck)
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME=cmscrm
DB_USER=cmscrm_user
DB_PASSWORD=cmscrm_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Sécurité (à changer en production)
SECRET_KEY=django-insecure-change-this-in-production-key
DEBUG=1
ALLOWED_HOSTS=*

# Frontend (pour emails, liens, etc.)
FRONTEND_URL=http://localhost:9194

# Email SMTP (optionnel en dev)
EMAIL_HOST=ssl0.ovh.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@cms-crm-solutions.com
